# LLM
OLLAMA_MODEL=qwen2.5:3b

# Embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# PDF processing
CHUNK_SIZE=350
CHUNK_OVERLAP=50

# Retrieval
TOP_K_DENSE=5
TOP_K_BM25=5
TOP_K_RERANK=5
FINAL_TOP_K=3

# Storage
CHROMA_DIR=chroma_db
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
